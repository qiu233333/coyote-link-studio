{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": ".server-build",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["server", "shared"]
}
