{
  "name": "coyote-link-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-agent.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "verify:limits": "tsx scripts/verify-limits-browser.ts",
    "verify:live": "tsx scripts/verify-limits-browser.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.70",
    "ai": "7.0.142",
    "dglab-kit": "1.0.5",
    "eve": "0.80.1",
    "express": "^5.1.0",
    "just-bash": "3.6.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
